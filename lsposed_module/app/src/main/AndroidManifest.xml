<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- MCP 调试服务器：局域网 HTTP 访问 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 界面交互震动反馈（滑块挡位、开关切换等） -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        usesCleartextTraffic：本地/局域网模型服务（Ollama、LM Studio、vLLM 等）普遍只提供
        http:// 明文接口，targetSdk >= 28 默认禁明文会导致请求直接抛
        "Cleartext HTTP traffic not permitted"，因此显式放开。
    -->
    <application
        android:name=".MagicWindowApp"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:description="@string/xposed_description"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MagicWindow"
        tools:ignore="MissingApplicationIcon">

        <!--
            libxposed 现代 API：模块标识不再使用任何 xposed* meta-data，
            模块名取 android:label、模块描述取 android:description，
            入口与作用域见 src/main/resources/META-INF/xposed/。
        -->

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- LSPosed 管理器「打开」按钮据此定位模块设置页，现代 API 仍需保留 -->
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!--
            桌面图标单独放在别名上：隐藏图标就是停用这个别名。
            主 Activity 只保留 LSPosed 的模块设置入口，图标隐藏后仍能从管理器进来。
        -->
        <activity-alias
            android:name=".ui.LauncherAlias"
            android:exported="true"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ui.AppListActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.AppDetailActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:parentActivityName=".ui.AppListActivity" />

        <activity
            android:name=".ai.AiChatActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:parentActivityName=".ui.MainActivity" />

    </application>

</manifest>
