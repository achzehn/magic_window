<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_bg"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:title="@string/ai_chat_title"
        app:titleTextAppearance="@style/Text.MagicWindow.CardTitle"
        app:navigationIcon="@drawable/ic_back"
        app:menu="@menu/menu_ai_chat" />

    <!-- 聊天消息列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/page_padding"
        android:paddingTop="@dimen/space_2"
        android:paddingBottom="@dimen/space_2" />

    <!-- 工具执行状态：胶囊内嵌状态点，与输入区同宽留白 -->
    <TextView
        android:id="@+id/tvToolStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginHorizontal="@dimen/page_padding"
        android:layout_marginBottom="@dimen/space_1"
        android:background="@drawable/bg_chip"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingHorizontal="@dimen/space_3"
        android:paddingVertical="6dp"
        android:textColor="?attr/colorPrimary"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 附件预览区 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAttachments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/page_padding"
        android:visibility="gone" />

    <!-- 输入区域：悬浮卡片，圆角 24dp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_3"
        android:layout_marginBottom="@dimen/space_3"
        android:background="@drawable/bg_input_panel"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_2"
        android:paddingTop="@dimen/space_2"
        android:paddingBottom="@dimen/space_1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom|center_horizontal"
            android:orientation="horizontal">

            <!-- 附件按钮：48dp 热区 -->
            <ImageButton
                android:id="@+id/btnAttach"
                android:layout_width="@dimen/min_touch"
                android:layout_height="@dimen/min_touch"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ai_attach"
                android:scaleType="centerInside"
                android:src="@drawable/ic_add"
                app:tint="?attr/colorOnSurfaceVariant" />

            <!-- 输入框 -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="@string/ai_input_hint"
                android:inputType="textMultiLine"
                android:maxLines="6"
                android:minLines="1"
                android:paddingHorizontal="@dimen/space_4"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:textSize="15sp" />

            <!-- 发送按钮：48dp 触摸热区 -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabSend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_1"
                android:layout_marginBottom="2dp"
                android:contentDescription="@string/ai_send"
                android:src="@drawable/ic_send"
                app:fabCustomSize="@dimen/min_touch"
                app:fabSize="mini"
                app:maxImageSize="20dp" />
        </LinearLayout>

        <!-- 模型切换：视觉为小胶囊，触摸高度仍为 48dp -->
        <TextView
            android:id="@+id/btnModelSwitch"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/min_touch"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chip"
            android:contentDescription="@string/ai_model_switch"
            android:drawablePadding="@dimen/space_1"
            app:drawableStartCompat="@drawable/ic_tune"
            android:gravity="center"
            android:maxWidth="240dp"
            android:paddingHorizontal="@dimen/space_3"
            android:singleLine="true"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>