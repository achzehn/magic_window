<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:liftOnScroll="true"
        app:liftOnScrollColor="@color/app_bg"
        app:statusBarForeground="@android:color/transparent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:title="@string/app_name"
            app:titleTextAppearance="@style/Text.MagicWindow.CardTitle" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/contentRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/page_padding"
            android:paddingTop="@dimen/space_2">

            <!-- 运行状态 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatus"
                style="@style/Widget.MagicWindow.Card.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentPadding="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/card_padding">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_icon_container"
                        android:backgroundTint="@color/container_blue"
                        android:contentDescription="@null"
                        android:padding="13dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_shield_check"
                        app:tint="@color/on_container_blue" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_4"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/tvStatusDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1"
                            android:lineSpacingMultiplier="1.2"
                            style="@style/Text.MagicWindow.Desc" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 应用设置 -->
            <TextView
                style="@style/Text.MagicWindow.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_1"
                android:layout_marginTop="@dimen/space_6"
                android:layout_marginBottom="@dimen/space_2"
                android:text="@string/section_apps" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardApps"
                style="@style/Widget.MagicWindow.Card.Clickable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/row_height"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_container"
                        android:backgroundTint="@color/container_blue"
                        android:contentDescription="@null"
                        android:padding="11dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_apps"
                        app:tint="@color/on_container_blue" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_4"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/action_app_list"
                            android:textAppearance="@style/Text.MagicWindow.CardTitle" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:text="@string/action_app_list_desc"
                            style="@style/Text.MagicWindow.Desc" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="@dimen/space_2"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- AI 助手 -->
            <TextView
                style="@style/Text.MagicWindow.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_1"
                android:layout_marginTop="@dimen/space_6"
                android:layout_marginBottom="@dimen/space_2"
                android:text="@string/ai_entry_title" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAi"
                style="@style/Widget.MagicWindow.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_icon_container"
                            android:backgroundTint="@color/container_purple"
                            android:contentDescription="@null"
                            android:padding="11dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_sparkle"
                            app:tint="@color/on_container_purple" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_4"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/ai_model_management"
                                android:textAppearance="@style/Text.MagicWindow.CardTitle" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:text="@string/ai_model_management_desc"
                                style="@style/Text.MagicWindow.Desc" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 当前模型 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:background="@drawable/bg_soft_block"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/min_touch"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/space_3"
                        android:paddingVertical="@dimen/space_2">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_2"
                            android:text="@string/ai_current_model"
                            style="@style/Text.MagicWindow.Caption" />

                        <TextView
                            android:id="@+id/tvAiModelName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAiModelStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_2"
                            android:background="@drawable/bg_pill"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAiModels"
                        style="@style/Widget.MagicWindow.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:text="@string/ai_manage_models"
                        app:icon="@drawable/ic_tune" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- AI 调试服务（MCP） -->
            <TextView
                style="@style/Text.MagicWindow.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_1"
                android:layout_marginTop="@dimen/space_6"
                android:layout_marginBottom="@dimen/space_2"
                android:text="@string/mcp_title" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMcp"
                style="@style/Widget.MagicWindow.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_container"
                            android:backgroundTint="@color/container_amber"
                            android:contentDescription="@null"
                            android:padding="10dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_bolt"
                            app:tint="@color/on_container_amber" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_3"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/mcp_state_title"
                                android:textAppearance="@style/Text.MagicWindow.CardTitle" />

                            <TextView
                                android:id="@+id/tvMcpState"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textSize="12sp"
                                android:textColor="@color/text_tertiary" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swMcp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_2" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:text="@string/mcp_desc"
                        style="@style/Text.MagicWindow.Desc" />

                    <TextView
                        android:id="@+id/tvMcpWarn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/mcp_warn"
                        style="@style/Text.MagicWindow.Desc" />

                    <!-- 本机地址 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/mcp_label_loopback"
                        style="@style/Text.MagicWindow.Caption" />

                    <TextView
                        android:id="@+id/tvMcpLoopback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:background="@drawable/bg_soft_block"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/min_touch"
                        android:paddingHorizontal="@dimen/space_3"
                        android:paddingVertical="@dimen/space_2"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <!-- 局域网地址 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:text="@string/mcp_label_lan"
                        style="@style/Text.MagicWindow.Caption" />

                    <TextView
                        android:id="@+id/tvMcpLan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:background="@drawable/bg_soft_block"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/min_touch"
                        android:paddingHorizontal="@dimen/space_3"
                        android:paddingVertical="@dimen/space_2"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/mcp_label_port"
                                style="@style/Text.MagicWindow.Caption" />

                            <TextView
                                android:id="@+id/tvMcpPort"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:background="@drawable/bg_soft_block"
                                android:gravity="center_vertical"
                                android:minHeight="@dimen/min_touch"
                                android:paddingHorizontal="@dimen/space_3"
                                android:paddingVertical="@dimen/space_2"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_3"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/mcp_label_token"
                                style="@style/Text.MagicWindow.Caption" />

                            <TextView
                                android:id="@+id/tvMcpToken"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:background="@drawable/bg_soft_block"
                                android:ellipsize="middle"
                                android:gravity="center_vertical"
                                android:minHeight="@dimen/min_touch"
                                android:paddingHorizontal="@dimen/space_3"
                                android:paddingVertical="@dimen/space_2"
                                android:singleLine="true"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMcpJson"
                        style="@style/Widget.MagicWindow.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="@dimen/space_3"
                        android:text="@string/mcp_btn_client_json" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:layout_marginBottom="112dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/reboot_hint"
                style="@style/Text.MagicWindow.Caption" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- AI 悬浮聊天按钮 -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAiChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_6"
        android:contentDescription="@string/ai_chat_title"
        android:src="@drawable/ic_sparkle"
        app:backgroundTint="?attr/colorPrimary"
        app:tint="?attr/colorOnPrimary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>