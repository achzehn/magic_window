<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ 形状体系 ============ -->
    <style name="ShapeAppearance.MagicWindow.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_small</item>
    </style>

    <style name="ShapeAppearance.MagicWindow.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_medium</item>
    </style>

    <style name="ShapeAppearance.MagicWindow.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_large</item>
    </style>

    <!-- ============ 主题 ============ -->
    <style name="Theme.MagicWindow" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 系统栏透明，内容边到边 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/is_light_theme</item>
        <item name="android:windowLightNavigationBar">@bool/is_light_theme</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:colorBackground">@color/app_bg</item>

        <!-- 品牌色 -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/brand_on_secondary</item>
        <item name="colorSecondaryContainer">@color/brand_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_on_secondary_container</item>

        <!-- 表面层级 -->
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/card_bg_high</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/card_bg</item>
        <item name="colorSurfaceContainerLow">@color/card_bg</item>
        <item name="colorSurfaceContainer">@color/card_bg</item>
        <item name="colorSurfaceContainerHigh">@color/card_bg</item>
        <item name="colorSurfaceContainerHighest">@color/card_bg_high</item>
        <item name="colorOutline">@color/stroke</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <item name="colorError">@color/conflict_error</item>
        <item name="colorControlHighlight">@color/ripple</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:listDivider">@color/divider</item>

        <!-- 圆角形状 -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.MagicWindow.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.MagicWindow.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.MagicWindow.Large</item>

        <!-- 组件默认样式 -->
        <item name="materialButtonStyle">@style/Widget.MagicWindow.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.MagicWindow.Button.Outlined</item>
        <item name="floatingActionButtonStyle">@style/Widget.MagicWindow.Fab</item>
        <item name="chipGroupStyle">@style/Widget.MagicWindow.ChipGroup</item>
        <item name="textInputStyle">@style/Widget.MagicWindow.TextInput.Outlined</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.MagicWindow.BottomSheet</item>
        <item name="materialCardViewStyle">@style/Widget.MagicWindow.Card</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MagicWindow.Dialog</item>

        <!-- 页面切换动效：220ms 淡入位移，遵循 Material 时长区间 -->
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowAnimationStyle">@style/Animation.MagicWindow.Activity</item>
    </style>

    <!-- ============ 页面/弹窗动效 ============ -->
    <style name="Animation.MagicWindow.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/activity_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/activity_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/activity_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/activity_close_exit</item>
    </style>

    <style name="Animation.MagicWindow.Dialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>

    <!-- 弹窗：180ms 缩放淡入，避免默认的瞬切 -->
    <style name="ThemeOverlay.MagicWindow.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowAnimationStyle">@style/Animation.MagicWindow.Dialog</item>
    </style>

    <!-- ============ 卡片 ============ -->
    <style name="Widget.MagicWindow.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="contentPadding">@dimen/card_padding</item>
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="rippleColor">?attr/colorControlHighlight</item>
    </style>

    <!-- 首页状态卡：渐变 + 浅描边 -->
    <style name="Widget.MagicWindow.Card.Hero" parent="Widget.MagicWindow.Card">
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="cardCornerRadius">@dimen/radius_hero</item>
        <item name="strokeColor">@color/hero_stroke</item>
    </style>

    <!-- 可点击的大卡片：按压时有轻微缩放（配合 Motion.pressScale） -->
    <style name="Widget.MagicWindow.Card.Clickable" parent="Widget.MagicWindow.Card">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <!-- ============ 文字 ============ -->
    <!-- 卡片标题 -->
    <style name="Text.MagicWindow.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- 分组标题 -->
    <style name="Text.MagicWindow.Section" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- 辅助说明 -->
    <style name="Text.MagicWindow.Desc" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <!-- 小标签 -->
    <style name="Text.MagicWindow.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <!-- ============ 按钮：48dp 热区，圆角 16dp ============ -->
    <style name="Widget.MagicWindow.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/min_touch</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.MagicWindow.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/min_touch</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.MagicWindow.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/min_touch</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- ============ FAB：圆角方形 ============ -->
    <style name="Widget.MagicWindow.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.MagicWindow.Fab</item>
        <item name="elevation">3dp</item>
    </style>

    <style name="ShapeAppearance.MagicWindow.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <!-- ============ Chip：48dp 触摸热区，圆角 12dp ============ -->
    <style name="Widget.MagicWindow.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">@dimen/radius_small</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipBackgroundColor">@color/chip_filter_bg</item>
        <item name="android:textColor">@color/chip_filter_text</item>
        <item name="android:textAppearance">@style/TextAppearance.MagicWindow.Chip</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">40dp</item>
        <item name="ensureMinTouchTargetSize">true</item>
    </style>

    <style name="TextAppearance.MagicWindow.Chip" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.MagicWindow.ChipGroup" parent="Widget.Material3.ChipGroup">
        <item name="chipSpacingHorizontal">8dp</item>
        <item name="chipSpacingVertical">8dp</item>
    </style>

    <!-- ============ 文本框：16dp 圆角描边 ============ -->
    <style name="Widget.MagicWindow.TextInput.Outlined" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_medium</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_medium</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_medium</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_medium</item>
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>

    <style name="Widget.MagicWindow.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">@dimen/radius_medium</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_medium</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_medium</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_medium</item>
    </style>

    <!-- 搜索框：浅色填充，20dp 圆角 -->
    <style name="Widget.MagicWindow.SearchBar" parent="Widget.Material3.TextInputLayout.FilledBox.Dense">
        <item name="boxCornerRadiusTopStart">20dp</item>
        <item name="boxCornerRadiusTopEnd">20dp</item>
        <item name="boxCornerRadiusBottomStart">20dp</item>
        <item name="boxCornerRadiusBottomEnd">20dp</item>
        <item name="boxBackgroundColor">@color/surface_soft</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="hintTextColor">@color/text_tertiary</item>
        <item name="startIconTint">@color/text_tertiary</item>
    </style>

    <!-- ============ 底部弹窗 ============ -->
    <style name="ThemeOverlay.MagicWindow.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.MagicWindow.BottomSheet</item>
    </style>

    <style name="Widget.MagicWindow.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.MagicWindow.BottomSheet</item>
        <item name="backgroundTint">@color/card_bg</item>
    </style>

    <style name="ShapeAppearance.MagicWindow.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>
</resources>