<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ 形状体系：HyperOS 大圆角 ============ -->
    <style name="ShapeAppearance.MagicWindow.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.MagicWindow.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.MagicWindow.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>

    <!-- ============ 主题 ============ -->
    <style name="Theme.MagicWindow" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 系统栏透明，内容边到边 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">@bool/is_light_theme</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:colorBackground">@color/app_bg</item>

        <!-- 品牌色 -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/brand_on_secondary</item>
        <item name="colorSecondaryContainer">@color/brand_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_on_secondary_container</item>

        <!-- 表面层级 -->
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/card_bg_high</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/card_bg</item>
        <item name="colorSurfaceContainerLow">@color/card_bg</item>
        <item name="colorSurfaceContainer">@color/card_bg</item>
        <item name="colorSurfaceContainerHigh">@color/card_bg</item>
        <item name="colorSurfaceContainerHighest">@color/card_bg_high</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <item name="colorError">@color/conflict_error</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:listDivider">@color/divider</item>

        <!-- 圆角形状 -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.MagicWindow.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.MagicWindow.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.MagicWindow.Large</item>

        <!-- 组件默认样式 -->
        <item name="materialButtonStyle">@style/Widget.MagicWindow.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.MagicWindow.Button.Outlined</item>
        <item name="floatingActionButtonStyle">@style/Widget.MagicWindow.Fab</item>
        <item name="chipGroupStyle">@style/Widget.MagicWindow.ChipGroup</item>
        <item name="textInputStyle">@style/Widget.MagicWindow.TextInput.Outlined</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.MagicWindow.BottomSheet</item>
    </style>

    <!-- ============ 卡片 ============ -->
    <style name="Widget.MagicWindow.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="contentPadding">@dimen/card_padding</item>
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">?attr/colorControlHighlight</item>
    </style>

    <!-- ============ 文字 ============ -->
    <!-- 大标题（折叠工具栏展开态） -->
    <style name="TextAppearance.MagicWindow.LargeTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- 卡片标题 -->
    <style name="Text.MagicWindow.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- 分组标题 -->
    <style name="Text.MagicWindow.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- 辅助说明 -->
    <style name="Text.MagicWindow.Desc" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- ============ 按钮：圆角 14dp，不全大写 ============ -->
    <style name="Widget.MagicWindow.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <style name="Widget.MagicWindow.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="Widget.MagicWindow.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- ============ FAB：圆角方形 ============ -->
    <style name="Widget.MagicWindow.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.MagicWindow.Fab</item>
        <item name="elevation">3dp</item>
    </style>

    <style name="ShapeAppearance.MagicWindow.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <!-- ============ Chip：圆角矩形，无描边 ============ -->
    <style name="Widget.MagicWindow.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">12dp</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipBackgroundColor">@color/chip_filter_bg</item>
        <item name="android:textColor">@color/chip_filter_text</item>
        <item name="android:textAppearance">@style/TextAppearance.MagicWindow.Chip</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">36dp</item>
    </style>

    <style name="TextAppearance.MagicWindow.Chip" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.MagicWindow.ChipGroup" parent="Widget.Material3.ChipGroup">
        <item name="chipSpacingVertical">6dp</item>
    </style>

    <!-- ============ 文本框：14dp 圆角描边 ============ -->
    <style name="Widget.MagicWindow.TextInput.Outlined" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>

    <style name="Widget.MagicWindow.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>

    <!-- 搜索框：灰色胶囊填充 -->
    <style name="Widget.MagicWindow.SearchBar" parent="Widget.Material3.TextInputLayout.FilledBox.Dense">
        <item name="boxCornerRadiusTopStart">26dp</item>
        <item name="boxCornerRadiusTopEnd">26dp</item>
        <item name="boxCornerRadiusBottomStart">26dp</item>
        <item name="boxCornerRadiusBottomEnd">26dp</item>
        <item name="boxBackgroundColor">@color/card_bg_high</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="hintTextColor">@color/text_secondary</item>
    </style>

    <!-- ============ 底部弹窗 ============ -->
    <style name="ThemeOverlay.MagicWindow.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.MagicWindow.BottomSheet</item>
    </style>

    <style name="Widget.MagicWindow.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.MagicWindow.BottomSheet</item>
        <item name="backgroundTint">@color/card_bg</item>
    </style>

    <style name="ShapeAppearance.MagicWindow.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>
</resources>
