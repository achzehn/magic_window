    <string name="batch_apply">套用</string>
    <string name="batch_clear">清除设置</string>
    <string name="batch_select_all">选中当前列表全部</string>
    <string name="batch_unselect">取消选中</string>
    <string name="batch_done">已更新 %1$d 个应用</string>

    <!-- 模式 -->
    <string name="mode_off">不处理</string>
    <string name="mode_full">通用全屏</string>
    <string name="mode_embedding">平行窗口</string>
    <string name="mode_fixed">固定横屏</string>
    <string name="mode_priority_hint">三种模式只能选一个。系统里的优先顺序是：固定横屏 &gt; 平行窗口 &gt; 通用全屏</string>

    <!-- 详情 -->
    <string name="detail_enable">对这个应用生效</string>
    <string name="detail_mode">选择模式</string>
    <string name="detail_builtin_hint">这个应用系统本来就有内置规则（%1$s），下面已经按系统的值填好，你可以直接在此基础上改</string>
    <string name="hint_inactive_section">当前没有选这个模式，下面的设置只会保存，不会生效</string>
    <string name="section_embedding">平行窗口设置</string>
    <string name="section_fixed">固定横屏设置</string>
    <string name="section_autoui">界面自动适配</string>
    <string name="section_autoui_desc">让应用在大屏上放大字体、拉宽布局，可以和上面的模式一起用</string>
    <string name="section_override">手动指定系统开关</string>
    <string name="section_override_desc">打开后就不再按上面选的模式自动决定开关，需要你自己保证三个开关不冲突</string>
    <string name="note_embedding">页面要填「Activity 全类名」，可以用 * 代表全部；多个之间用英文逗号 , 隔开。留空表示不设置这一项。</string>
    <string name="note_fixed">「全屏拉伸」会把画面铺满整个屏幕，可能变形；「横屏信箱」保持原比例居中显示，两边留黑边。</string>
    <string name="note_override">三个开关分别对应系统设置里的平行窗口、固定横屏、全屏拉伸，一般只需要打开其中一个。</string>
