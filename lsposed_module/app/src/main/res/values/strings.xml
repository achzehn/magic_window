<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">完美横屏</string>
    <string name="xposed_description">让更多应用支持平行窗口、横屏和大屏布局</string>

    <!-- 主页 -->
    <string name="status_active">模块已生效</string>
    <string name="status_inactive">模块还没生效：请在 LSPosed 里打开本模块，并勾选「系统框架」</string>
    <string name="status_configured">已经设置了 %1$d 个应用</string>
    <string name="section_apps">应用设置</string>
    <string name="action_app_list">选择应用</string>
    <string name="action_app_list_desc">只有在这里设置过的应用才会被处理，没设置的完全不动</string>
    <string name="section_advanced">进阶设置（不懂就别改）</string>
    <string name="opt_verify_gates">开机检查系统开关</string>
    <string name="opt_verify_gates_desc">开机时看一下系统的平行窗口、大屏适配总开关是否打开，并记到日志里</string>
    <string name="opt_force_ae">系统关了平行窗口时强行打开</string>
    <string name="opt_force_ae_desc">如果系统把平行窗口总开关关掉了，就骗系统说它是开着的</string>
    <string name="opt_force_autoui">系统关了大屏适配时强行打开</string>
    <string name="opt_force_autoui_desc">如果系统把界面自动适配（autoui）关掉了，就骗系统说它是开着的</string>
    <string name="opt_flip_switch">替应用打开「设置里的开关」</string>
    <string name="opt_flip_switch_desc">相当于自动帮你在系统设置里给这个应用打开平行窗口／横屏开关，效果最明显，建议保持开启</string>
    <string name="opt_query_hook">让系统认为应用在名单里</string>
    <string name="opt_query_hook_desc">系统查「这个应用支持不支持」时，直接回答支持</string>
    <string name="opt_enable_query_hook">连「已开启」也一并谎报</string>
    <string name="opt_enable_query_hook_desc">系统在多处会问「这个应用当前是否已开启」，打开后一律回答已开启，兜底更彻底</string>
    <string name="opt_rule_table_inject">直接写进系统规则表</string>
    <string name="opt_rule_table_inject_desc">把固定横屏规则塞进系统内部的规则表，并阻止系统把它清掉；依赖机型内部结构，出问题可关掉</string>
    <string name="opt_override_disable">忽略系统的禁用名单</string>
    <string name="opt_override_disable_desc">系统内置名单里有近 200 个应用被标记为禁用，打开后不再理会这个标记</string>
    <string name="opt_autoui_inject">注入大屏布局规则</string>
    <string name="opt_autoui_inject_desc">把你的界面适配规则写成一份「云端配置」交给系统读取</string>
    <string name="opt_cloud_version">配置版本号</string>
    <string name="opt_cloud_version_desc">必须大于系统自带的 360816，否则系统会继续用它自己的规则</string>
    <string name="opt_hook_cloud_string">让系统自己写版本号</string>
    <string name="opt_hook_cloud_string_desc">换一种更温和的方式抬高版本号，兼容性更好但属于实验功能</string>
    <string name="opt_verbose">输出详细日志</string>
    <string name="opt_verbose_desc">把每一次判断结果都写进 LSPosed 日志，排查问题时再开</string>
    <string name="reboot_hint">改完需要重启手机才会生效</string>

    <!-- 作用域建议 -->
    <string name="scope_title">在 LSPosed 里要勾哪些</string>
    <string name="scope_desc">只需要勾「系统框架」（Android Framework）。全部注入都发生在 system_server 里，不需要勾任何被适配的应用；「完美横屏」自身会自动勾上，只用来回显激活状态和接收抓取结果。</string>

