    <string name="title_app_list">选择应用</string>
    <string name="search_hint">搜索应用名或包名</string>
    <string name="filter_all">全部</string>
    <string name="filter_builtin">系统已内置</string>
    <string name="filter_configured">已设置</string>
    <string name="filter_user">已安装</string>
